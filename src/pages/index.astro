---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Content from "@content/diary.md";
import iconImage from "@public/icon.jpg";
---

<Layout>
  <div class="flex h-dvh w-dvw bg-[url('/background.png')] bg-cover bg-fixed bg-center">
    <div class="flex grow justify-center">
      <div class="mx-3 my-6 flex max-w-xl grow flex-col gap-4 bg-white p-5">
        <div class="flex flex-row items-center gap-3">
          <Image src={iconImage} alt="icon" class="h-8 w-8 rounded-full" />
          <h1 class="text-lg">今日の日記</h1>
        </div>
        <div class="main grow overflow-auto pr-2">
          <Content />
        </div>
      </div>
    </div>
  </div>
</Layout>
